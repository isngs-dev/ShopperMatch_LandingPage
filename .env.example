# Copy to .env.local and fill in. Never commit real keys.

# Google Calendar + Meet + Gmail (one OAuth client, one refresh token).
# Get the refresh token with:  node scripts/google-auth.mjs   (needs the Calendar API and the Gmail API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that owns the demo slots (default: the organiser's primary calendar)
GOOGLE_CALENDAR_ID=primary

# Confirmation mail goes out through the Gmail API, from this mailbox (the account that signed in above,
# or one of its "Send mail as" aliases)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Shopper Match.AI
# Optional: where replies go (default: MAIL_FROM_EMAIL)
MAIL_REPLY_TO=
# iSN team address(es), Cc'd on every visitor confirmation (comma-separated)
MAIL_CC=

# Optional fallback if Google Calendar is not configured: one fixed link for every booking
MEETING_LINK=
