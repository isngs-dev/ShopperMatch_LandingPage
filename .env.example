# Copy to .env.local and fill in. Never commit real keys.

# SendGrid (https://app.sendgrid.com/settings/api_keys, "Mail Send" permission)
SENDGRID_API_KEY=
# Must be a verified Sender / authenticated domain in SendGrid
SENDGRID_FROM_EMAIL=

# Google Calendar + Meet (creates a unique Meet link per booking).
# Get the refresh token with:  node scripts/google-auth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that owns the demo slots (default: the organiser's primary calendar)
GOOGLE_CALENDAR_ID=primary

# Optional fallback if Google is not configured: one fixed link for every booking
MEETING_LINK=
